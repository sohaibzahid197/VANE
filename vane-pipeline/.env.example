# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# A free Demo key is enough for development and testing:
#   coingecko.com/en/api/pricing -> Start for Free (Demo)
#   Developer Dashboard -> + Add New Key
#
# The Demo tier is NOT licensed for commercial distribution. Building and
# testing is fine; charging users requires a paid tier (Basic, $35/mo).
COINGECKO_API_KEY=CG-replace-me

# demo = api.coingecko.com with x-cg-demo-api-key
# pro  = pro-api.coingecko.com with x-cg-pro-api-key
# A mismatch between key and tier answers 401 and looks exactly like an
# expired key, so check this first when authentication fails.
COINGECKO_TIER=demo

# Only needed for a publishing run (refresh). The probe does not touch Firebase.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# --- Cadence, for the credit-budget projection -----------------------------
# Defaults describe the PRODUCTION cadence, which needs ~66,000 credits/month
# and therefore a paid tier. The free Demo plan allows 10,000.
#
# To develop on a free Demo key, uncomment these — roughly 4,800 credits/month:
# UNIVERSE_SIZE=50
# PRICES_PER_DAY=6
# SIGNALS_PER_DAY=1
# HISTORY_PER_DAY=1
